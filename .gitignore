# Shared ignore rules for all Android Studio projects in this repository.
# Patterns without a leading "/" apply in every project subfolder.

# Build output and caches
build/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Machine-specific settings (SDK path, possibly secrets)
local.properties

# Android Studio / IntelliJ: personal and generated files
*.iml
**/.idea/caches/
**/.idea/libraries/
**/.idea/modules.xml
**/.idea/workspace.xml
**/.idea/navEditor.xml
**/.idea/assetWizardSettings.xml
**/.idea/deploymentTargetSelector.xml
**/.idea/deviceManager.xml
**/.idea/vcs.xml
**/.idea/claudeCodeEditorTabs.xml

# Signing keys: never commit
*.jks
*.keystore

# OS files
.DS_Store
Thumbs.db
